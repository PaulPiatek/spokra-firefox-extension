{
  "name": "spokra",
  "version": "0.10.1",
  "description": "Firefox extension that reads selected text aloud, on-device, with the Phonon 31M voice.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "web-ext lint",
    "clean": "node scripts/clean.mjs",
    "package-assets": "node scripts/package-assets.mjs",
    "build": "npm run clean && npm run vendor && npm run package-assets && npm run lint && npm test",
    "sign": "npm run build && node scripts/sign.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "check-model": "node scripts/check-model.mjs",
    "bench": "node scripts/bench.mjs",
    "vendor": "node scripts/vendor-runtime.mjs"
  },
  "devDependencies": {
    "phonon-tts": "0.4.2",
    "web-ext": "10.8.0"
  }
}
